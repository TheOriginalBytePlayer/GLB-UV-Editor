{
  "name": "glb-uv-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GLB Mesh Editor: load a GLB, edit points, polygons and UVs, save the GLB.",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --require \"tests/features/steps/**/*.mjs\" \"tests/features/**/*.feature\""
  },
  "dependencies": {
    "@babylonjs/core": "^9.25.0",
    "@babylonjs/loaders": "^9.25.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
